# kw-core（Kotlin）。UI（Vite ビルド）も同じイメージに焼き、core が静的配信する。

# 1) Web UI
FROM oven/bun:1.3-debian AS web
WORKDIR /src
COPY package.json bun.lock tsconfig.json ./
COPY packages ./packages
RUN bun install
WORKDIR /src/packages/web
RUN bun run build

# 2) Kotlin core
FROM gradle:9-jdk25 AS build
WORKDIR /src
COPY core/settings.gradle.kts core/build.gradle.kts ./
COPY core/src ./src
RUN gradle installDist --no-daemon -q

# 3) 実行イメージ（git 操作を行うため git を入れる）
FROM eclipse-temurin:25-jre
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /src/build/install/kw-core /opt/kw-core
COPY --from=web /src/packages/web/dist /opt/kw-web

ENV KW_WEB_DIR=/opt/kw-web
EXPOSE 4646

ENTRYPOINT ["/opt/kw-core/bin/kw-core"]
