# docker compose 用の設定。`cp env.example .env` して埋める。

# --- モデル認証（どちらか一方） ---------------------------------------------
# D13 のとおり PoC はクレデンシャルプロキシを持たず、実行者の認証をそのまま使う。
#
# 1) サブスク（OAuth）を使う場合：ホストで下記を実行して出力を貼る
#      claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# 2) API キーを使う場合
ANTHROPIC_API_KEY=

# --- runner をホストで動かす場合 --------------------------------------------
# macOS の Claude Code は認証情報を Keychain に持つためコンテナから読めない。
# トークンを用意しないときは runner だけホストで動かす:
#
#   docker compose up -d --build --wait
#   docker compose stop runner
#   cd runner && bun start
#   KW_ENGINE_URL=http://host.docker.internal:4647 docker compose up -d --no-deps backend
#
# 毎回指定するのが面倒なら下の行を有効にする（--no-deps は依然必要）
# KW_ENGINE_URL=http://host.docker.internal:4647
