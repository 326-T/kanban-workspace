# kw-engine（bun）。Agent SDK は CLI をプラットフォーム別のネイティブ依存として配布するため、
# node_modules はコンテナ内で install してイメージに焼く（ホストの darwin 用は使えない）。
FROM oven/bun:1.3-debian

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        git ca-certificates curl python3 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json bun.lock tsconfig.json ./
COPY packages ./packages
RUN bun install

ENV KW_ENGINE_PORT=4647
EXPOSE 4647

CMD ["bun", "packages/engine/src/index.ts"]
